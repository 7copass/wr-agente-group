CHATWOOT_URL=https://chat.exemplo.com.br
CHATWOOT_ACCOUNT_ID=12
CHATWOOT_API_TOKEN=
# Token do bot "Alex" criado pelo npm run setup:chatwoot. Nunca o do bot 25.
CHATWOOT_BOT_TOKEN=
# Inbox de TESTE. Nunca a 43 enquanto estiver em teste.
CHATWOOT_INBOX_IDS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Segredo que vai na URL do webhook (?token=). Gere com: openssl rand -hex 24
WEBHOOK_SECRET=
DEBOUNCE_MS=10000
DRY_RUN=false
# Vazio = responde todo mundo. Preenchido = só estes números (DDD + número).
ALLOWED_NUMBERS=91999999999,93999999999
PORT=3000
